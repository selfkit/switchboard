{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Switchboard",
  "version": "0.1.9",
  "identifier": "com.switchboard.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build:app",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Switchboard",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 700,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'none'; form-action 'none'; frame-src 'none'",
      "devCsp": "default-src 'self' ipc: http://ipc.localhost ws://localhost:1420; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; object-src 'none'",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "copyright": "Copyright © 2026 tan · MIT License",
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "dmg": {
        "background": "assets/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 178,
          "y": 248
        },
        "applicationFolderPosition": {
          "x": 482,
          "y": 248
        }
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ0QTdBRjhGNURDNUM4NkUKUldSdXlNVmRqNituUkowVk5KQTdSUzFuRHYvOURyM250QWN3VmZPaWtVeFV6bmpqTXZ1Q1EwM3QK",
      "endpoints": [
        "https://gitee.com/etn/switchboard_store/raw/master/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
